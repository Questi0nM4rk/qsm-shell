#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

node "$root/scripts/generate-tokens.mjs"
# `previews/units` and `tests/units` fill up one type at a time, so lint what
# is there rather than what will be.
lint_dir() {
  local dir="$1"
  compgen -G "$dir"/*.qml >/dev/null || return 0
  /usr/lib/qt6/bin/qmllint -I "$root/qml" "$dir"/*.qml
}

/usr/lib/qt6/bin/qmllint -I "$root/qml" "$root"/qml/QsmShell/Style/*.qml "$root"/qml/QsmShell/Components/*.qml
lint_dir "$root/previews"
lint_dir "$root/previews/units"
lint_dir "$root/tests"
lint_dir "$root/tests/interaction"
lint_dir "$root/tests/units"

QT_QPA_PLATFORM=offscreen \
QT_QUICK_BACKEND=software \
QT_FORCE_STDERR_LOGGING=1 \
    /usr/lib/qt6/bin/qml -I "$root/qml" "$root/tests/Smoke.qml"

# Real pointer and keyboard events against real components. The Qt6 runner at
# this path works fine -- it is /usr/bin/qmltestrunner that is Qt5 and cannot
# load a Qt6 module, which is what the backlog's environment note meant and
# what kept this repo from having interaction tests at all.
run_tests() {
  local dir="$1"
  compgen -G "$dir"/*.qml >/dev/null || return 0
  QT_QPA_PLATFORM=offscreen \
  QT_QUICK_BACKEND=software \
      /usr/lib/qt6/bin/qmltestrunner -import "$root/qml" -input "$dir"
}

run_tests "$root/tests/interaction"
run_tests "$root/tests/units"

bash -n "$root/scripts/build-shaders"

# Shader freshness: the committed .qsb must match what build-shaders
# regenerates from the committed .frag. qsb output is deterministic, so a
# difference means a .frag edit landed without a rebuild -- and the runtime
# only ever reads the .qsb, so that edit would be invisible until it wasn't.
shaders_dir="$root/qml/QsmShell/shaders"
before="$(sha256sum "$shaders_dir"/*.qsb)"
"$root/scripts/build-shaders" >/dev/null
[[ "$before" == "$(sha256sum "$shaders_dir"/*.qsb)" ]] || {
  printf 'shader .qsb drift: run scripts/build-shaders and commit the result\n' >&2
  exit 1
}

printf 'qsm-shell validation passed\n'
