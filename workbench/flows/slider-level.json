{
  "version": 1,
  "key": "slider-level",
  "target": { "story": "level" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "value", "equals": 87 },
    { "type": "expect", "observable": "range", "equals": false },
    { "type": "expect", "observable": "can-increase", "equals": true },
    { "type": "action", "name": "increase" },
    { "type": "expect", "observable": "value", "equals": 92 },
    { "type": "expectEvent", "event": "moved", "origin": "component" },
    { "type": "action", "name": "maximum" },
    { "type": "expect", "observable": "value", "equals": 100 },
    { "type": "expect", "observable": "can-increase", "equals": false },
    { "type": "action", "name": "minimum" },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "expect", "observable": "can-decrease", "equals": false },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "can-increase", "equals": false },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "control", "group": "range", "option": "range" },
    { "type": "expect", "observable": "range", "equals": true },
    { "type": "expect", "observable": "low-value", "equals": 0 },
    { "type": "control", "group": "thumb", "option": "pill" },
    { "type": "expect", "observable": "thumb-style", "equals": "pill" },
    { "type": "control", "group": "size", "option": "sm" },
    { "type": "expect", "observable": "size", "equals": "sm" },
    { "type": "control", "group": "wheel", "option": "nudge" },
    { "type": "expect", "observable": "wheel-units", "equals": 1 },
    { "type": "control", "group": "label", "option": "action" },
    { "type": "expect", "observable": "label-clickable", "equals": true }
  ]
