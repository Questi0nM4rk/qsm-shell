{
  "version": 1,
  "key": "dialog-keyboard",
  "target": { "story": "dialog" },
  "steps": [
    { "type": "reset" },
    { "type": "await", "observable": "focus", "equals": "keep" },
    { "type": "key", "target": "dialog", "key": "Tab" },
    { "type": "expect", "observable": "focus", "equals": "remove" },
    { "type": "key", "target": "dialog", "key": "Tab" },
    { "type": "expect", "observable": "focus", "equals": "keep" },
    { "type": "key", "target": "dialog", "key": "Backtab" },
    { "type": "expect", "observable": "focus", "equals": "remove" },
    { "type": "key", "target": "dialog", "key": "Escape" },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component" },
    { "type": "expect", "observable": "dismissals", "equals": 1 },
    { "type": "expect", "observable": "open", "equals": false },
    { "type": "await", "observable": "visible", "equals": false },
    { "type": "pointer", "target": "invoker", "event": "click" },
    { "type": "expect", "observable": "open", "equals": true },
    { "type": "await", "observable": "focus", "equals": "keep" },
    { "type": "key", "target": "dialog", "key": "Space" },
    { "type": "expectEvent", "event": "cancel-clicked", "origin": "component" },
    { "type": "expect", "observable": "cancels", "equals": 1 },
    { "type": "expect", "observable": "open", "equals": false },
    { "type": "await", "observable": "focus", "equals": "invoker" },
    { "type": "key", "target": "scene", "key": "Enter" },
    { "type": "expect", "observable": "open", "equals": true },
    { "type": "await", "observable": "focus", "equals": "keep" },
    { "type": "key", "target": "dialog", "key": "Tab" },
    { "type": "key", "target": "dialog", "key": "Enter" },
    { "type": "expectEvent", "event": "confirm-clicked", "origin": "component" },
    { "type": "expect", "observable": "confirms", "equals": 1 },
    { "type": "expect", "observable": "open", "equals": false },
    { "type": "await", "observable": "focus", "equals": "invoker" }
  ]
}
