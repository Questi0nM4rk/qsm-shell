{
  "version": 1,
  "key": "month-calendar-input",
  "target": { "story": "calendar" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "shown", "equals": "2026-08" },
    { "type": "expect", "observable": "cell-count", "equals": 42 },
    { "type": "expect", "observable": "cell-size", "equals": 32 },
    { "type": "expect", "observable": "today-announced", "equals": true },
    { "type": "pointer", "target": "next", "event": "click" },
    { "type": "expectEvent", "event": "month-shifted", "origin": "component", "payload": { "delta": 1 } },
    { "type": "expect", "observable": "shown", "equals": "2026-09" },
    { "type": "expect", "observable": "today-announced", "equals": true },
    { "type": "pointer", "target": "previous", "event": "click" },
    { "type": "expectEvent", "event": "month-shifted", "origin": "component", "payload": { "delta": -1 } },
    { "type": "expect", "observable": "shown", "equals": "2026-08" },
    { "type": "key", "target": "calendar", "key": "Right" },
    { "type": "expect", "observable": "shown", "equals": "2026-09" },
    { "type": "key", "target": "calendar", "key": "PageDown" },
    { "type": "expect", "observable": "shown", "equals": "2026-10" },
    { "type": "key", "target": "calendar", "key": "Left" },
    { "type": "expect", "observable": "shown", "equals": "2026-09" },
    { "type": "key", "target": "calendar", "key": "PageUp" },
    { "type": "expect", "observable": "shown", "equals": "2026-08" },
    { "type": "pointer", "target": "calendar", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "expect", "observable": "shown", "equals": "2026-09" },
    { "type": "pointer", "target": "calendar", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expect", "observable": "shown", "equals": "2026-08" },
    { "type": "pointer", "target": "calendar", "event": "wheel", "dx": 120, "dy": 0 },
    { "type": "expect", "observable": "shown", "equals": "2026-08" },
    { "type": "expect", "observable": "shifts", "equals": 8 },
    { "type": "control", "group": "today", "option": "before" },
    { "type": "expect", "observable": "today-announced", "equals": true },
    { "type": "control", "group": "size", "option": "sm" },
    { "type": "await", "observable": "cell-size", "equals": 24 }
  ]
}
