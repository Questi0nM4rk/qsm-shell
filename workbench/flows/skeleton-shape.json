{
  "version": 1,
  "key": "skeleton-shape",
  "target": { "story": "skeleton" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "role", "equals": "label" },
    { "type": "expect", "observable": "fraction", "equals": 1 },
    { "type": "expect", "observable": "size", "equals": "md" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "size", "option": "sm" },
    { "type": "expect", "observable": "size", "equals": "sm" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "hero" },
    { "type": "expect", "observable": "role", "equals": "hero" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "display" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "heading" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "title" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "body" },
    { "type": "expect", "observable": "role", "equals": "body" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "role", "option": "metadata" },
    { "type": "expect", "observable": "role", "equals": "metadata" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "width", "option": "short" },
    { "type": "expect", "observable": "fraction", "equals": 0.6 },
    { "type": "control", "group": "data", "option": "loaded" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 },
    { "type": "control", "group": "data", "option": "loading" },
    { "type": "expect", "observable": "landing-jump", "equals": 0 }
  ]
}
