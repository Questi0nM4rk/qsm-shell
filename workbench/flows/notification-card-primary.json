{
  "version": 1,
  "key": "notification-card-primary",
  "target": { "story": "notification" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "primary-available", "equals": true },
    { "type": "expect", "observable": "primary-callback-count", "equals": 0 },
    { "type": "pointer", "target": "card", "event": "move", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "hovered", "equals": true },
    { "type": "pointer", "target": "card", "event": "press", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "pressed", "equals": true },
    { "type": "expect", "observable": "primary-callback-count", "equals": 0 },
    { "type": "pointer", "target": "card", "event": "release", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "pressed", "equals": false },
    { "type": "expectEvent", "event": "primary-triggered", "origin": "component" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 1 },
    { "type": "action", "name": "focus" },
    { "type": "expect", "observable": "focused", "equals": true },
    { "type": "key", "target": "card", "key": "Enter" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 2 },
    { "type": "key", "target": "card", "key": "Space" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 3 },
    { "type": "action", "name": "activate-primary" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 4 },
    { "type": "control", "group": "default-action", "option": "no-default" },
    { "type": "expect", "observable": "primary-available", "equals": false },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 4 },
    { "type": "control", "group": "default-action", "option": "provided" },
    { "type": "control", "group": "input", "option": "retiring" },
    { "type": "expect", "observable": "input-enabled", "equals": false },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 4 },
    { "type": "control", "group": "input", "option": "eligible" },
    { "type": "control", "group": "record", "option": "archived" },
    { "type": "expect", "observable": "primary-available", "equals": false }
  ]
}
