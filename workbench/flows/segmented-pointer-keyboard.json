{
  "version": 1,
  "key": "segmented-pointer-keyboard",
  "target": { "story": "segmented" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "expect", "observable": "segment-height", "equals": 40 },
    { "type": "pointer", "target": "overview", "event": "click", "x": 0.5, "y": 0.02 },
    { "type": "expectEvent", "event": "selected", "origin": "component", "payload": { "index": 0 } },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "key", "target": "bar", "key": "Right" },
    { "type": "expectEvent", "event": "selected", "origin": "component", "payload": { "index": 1 } },
    { "type": "key", "target": "bar", "key": "Right" },
    { "type": "expect", "observable": "current-index", "equals": 2 },
    { "type": "key", "target": "bar", "key": "Right" },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "key", "target": "bar", "key": "End" },
    { "type": "expect", "observable": "current-index", "equals": 2 },
    { "type": "key", "target": "bar", "key": "Home" },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "key", "target": "bar", "key": "Left" },
    { "type": "expect", "observable": "current-index", "equals": 2 },
    { "type": "control", "group": "middle-option", "option": "disabled" },
    { "type": "key", "target": "bar", "key": "Left" },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "control", "group": "middle-option", "option": "enabled" },
    { "type": "pointer", "target": "alerts", "event": "move", "x": 0.5, "y": 0.98 },
    { "type": "await", "observable": "hovered", "equals": 2 },
    { "type": "pointer", "target": "alerts", "event": "press", "x": 0.5, "y": 0.98 },
    { "type": "await", "observable": "pressed", "equals": 2 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "await", "observable": "pressed", "equals": -1 },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.02, "y": 0.02 },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "control", "group": "host", "option": "refuses" },
    { "type": "pointer", "target": "media", "event": "click" },
    { "type": "expectEvent", "event": "selected", "origin": "component", "payload": { "index": 1 } },
    { "type": "expect", "observable": "current-index", "equals": 0 }
  ]
}
