{
  "version": 1,
  "key": "stat-trend-emphasis",
  "target": { "story": "stat" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "value", "equals": "72" },
    { "type": "expect", "observable": "label", "equals": "CPU" },
    { "type": "expect", "observable": "trend", "equals": "up" },
    { "type": "expect", "observable": "good", "equals": "down" },
    { "type": "expect", "observable": "emphasis", "equals": "display" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 72%, rising, worse" },
    { "type": "control", "group": "good", "option": "up" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 72%, rising, better" },
    { "type": "control", "group": "trend", "option": "down" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 72%, falling, worse" },
    { "type": "control", "group": "trend", "option": "flat" },
    { "type": "expect", "observable": "trend", "equals": "flat" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 72%, steady" },
    { "type": "control", "group": "trend", "option": "up" },
    { "type": "control", "group": "good", "option": "none" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 72%, rising" },
    { "type": "control", "group": "emphasis", "option": "hero" },
    { "type": "expect", "observable": "emphasis", "equals": "hero" },
    { "type": "control", "group": "label", "option": "bare" },
    { "type": "expect", "observable": "label", "equals": "" },
    { "type": "expect", "observable": "accessible-name", "equals": "72%, rising" },
    { "type": "control", "group": "label", "option": "named" },
    { "type": "expect", "observable": "label", "equals": "CPU" },
    { "type": "control", "group": "value", "option": "empty" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, no reading" },
    { "type": "control", "group": "value", "option": "long" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 123456789012345678%, rising" }
  ]
}
