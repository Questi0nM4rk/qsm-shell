{
  "version": 1,
  "key": "notification-card-list",
  "target": { "story": "notification" },
  "steps": [
    { "type": "reset" },
    { "type": "control", "group": "surface", "option": "list" },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "pointer", "target": "card", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "hovered", "equals": true },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "pointer", "target": "card", "event": "move", "x": 0.06, "y": 0.4 },
    { "type": "expect", "observable": "hovered", "equals": true },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.06, "y": 0.4 },
    { "type": "expectEvent", "event": "expand-requested", "origin": "component" },
    { "type": "expect", "observable": "expand-requests", "equals": 1 },
    { "type": "expect", "observable": "activation-count", "equals": 0 },
    { "type": "await", "observable": "expanded", "equals": true },
    { "type": "await", "observable": "height", "equals": 110 },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.205, "y": 0.827 },
    { "type": "expectEvent", "event": "action-invoked", "origin": "component", "payload": { "action": "mark-read" } },
    { "type": "expect", "observable": "last-action", "equals": "mark-read" },
    { "type": "expect", "observable": "activation-count", "equals": 0 },
    { "type": "action", "name": "second-action" },
    { "type": "expect", "observable": "last-action", "equals": "default" },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.6, "y": 0.4 },
    { "type": "expectEvent", "event": "activated", "origin": "component" },
    { "type": "expect", "observable": "activation-count", "equals": 1 },
    { "type": "expect", "observable": "expand-requests", "equals": 1 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 0 },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.06, "y": 0.4 },
    { "type": "expect", "observable": "expand-requests", "equals": 2 },
    { "type": "await", "observable": "expanded", "equals": false },
    { "type": "control", "group": "record", "option": "archived" },
    { "type": "expect", "observable": "archived", "equals": true },
    { "type": "control", "group": "input", "option": "retiring" },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.06, "y": 0.4 },
    { "type": "expect", "observable": "expand-requests", "equals": 2 }
  ]
}
