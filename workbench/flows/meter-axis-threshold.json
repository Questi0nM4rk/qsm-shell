{
  "version": 1,
  "key": "meter-axis-threshold",
  "target": { "story": "meter" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "value", "equals": 0.08 },
    { "type": "expect", "observable": "low-threshold", "equals": 0.2 },
    { "type": "expect", "observable": "high-threshold", "equals": -1 },
    { "type": "expect", "observable": "orientation", "equals": 1 },
    { "type": "expect", "observable": "breached", "equals": true },
    { "type": "await", "observable": "fill-share", "equals": 0.08 },
    { "type": "expect", "observable": "description", "equals": "8%, low" },
    { "type": "control", "group": "value", "option": "high" },
    { "type": "expect", "observable": "breached", "equals": false },
    { "type": "await", "observable": "fill-share", "equals": 0.86 },
    { "type": "expect", "observable": "description", "equals": "86%" },
    { "type": "control", "group": "threshold", "option": "high" },
    { "type": "expect", "observable": "low-threshold", "equals": -1 },
    { "type": "expect", "observable": "high-threshold", "equals": 0.8 },
    { "type": "expect", "observable": "breached", "equals": true },
    { "type": "expect", "observable": "description", "equals": "86%, high" },
    { "type": "control", "group": "axis", "option": "vertical" },
    { "type": "expect", "observable": "orientation", "equals": 2 },
    { "type": "await", "observable": "fill-share", "equals": 0.86 },
    { "type": "control", "group": "value", "option": "low" },
    { "type": "await", "observable": "fill-share", "equals": 0.08 },
    { "type": "control", "group": "axis", "option": "horizontal" },
    { "type": "expect", "observable": "orientation", "equals": 1 },
    { "type": "await", "observable": "fill-share", "equals": 0.08 },
    { "type": "control", "group": "threshold", "option": "none" },
    { "type": "expect", "observable": "breached", "equals": false },
    { "type": "control", "group": "value", "option": "empty" },
    { "type": "await", "observable": "fill-share", "equals": 0 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "expect", "observable": "enabled", "equals": true }
  ]
}
