{
  "version": 1,
  "key": "checkbox-tri-state",
  "target": { "story": "checkbox" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selected-count", "equals": 2 },
    { "type": "expect", "observable": "all-mixed", "equals": true },
    { "type": "expect", "observable": "all-checked", "equals": false },
    { "type": "expect", "observable": "accessible-mixed", "equals": true },
    { "type": "expect", "observable": "accessible-checked", "equals": false },
    { "type": "pointer", "target": "documents", "event": "click" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "item": "documents", "checked": false } },
    { "type": "expect", "observable": "selected-count", "equals": 1 },
    { "type": "expect", "observable": "all-mixed", "equals": true },
    { "type": "key", "target": "documents", "key": "Space" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "item": "documents", "checked": true } },
    { "type": "expect", "observable": "selected-count", "equals": 2 },
    { "type": "pointer", "target": "all", "event": "click" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "item": "all", "checked": true } },
    { "type": "expect", "observable": "selected-count", "equals": 3 },
    { "type": "expect", "observable": "all-checked", "equals": true },
    { "type": "expect", "observable": "all-mixed", "equals": false },
    { "type": "expect", "observable": "accessible-checked", "equals": true },
    { "type": "key", "target": "all", "key": "Enter" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "item": "all", "checked": false } },
    { "type": "expect", "observable": "selected-count", "equals": 0 },
    { "type": "expect", "observable": "all-checked", "equals": false },
    { "type": "expect", "observable": "all-mixed", "equals": false },
    { "type": "control", "group": "selection", "option": "some" },
    { "type": "action", "name": "toggle-first" },
    { "type": "expect", "observable": "selected-count", "equals": 1 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "action", "name": "toggle-all" },
    { "type": "expect", "observable": "selected-count", "equals": 1 }
  ]
}
