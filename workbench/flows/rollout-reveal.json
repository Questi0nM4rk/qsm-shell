{
  "version": 1,
  "key": "rollout-reveal",
  "target": { "story": "rollout-hover" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "attached-top", "equals": true },
    { "type": "expect", "observable": "attached-bottom", "equals": false },
    { "type": "expect", "observable": "hit-active", "equals": true },
    { "type": "expect", "observable": "capsules", "equals": 0 },
    { "type": "control", "group": "edge", "option": "bottom" },
    { "type": "expect", "observable": "attached-bottom", "equals": true },
    { "type": "expect", "observable": "attached-top", "equals": false },
    { "type": "control", "group": "mode", "option": "hidden" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "hit-active", "equals": false },
    { "type": "control", "group": "mode", "option": "suppressed" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "hit-active", "equals": false },
    { "type": "control", "group": "mode", "option": "shown" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "hit-active", "equals": true },
    { "type": "control", "group": "state", "option": "fullscreen" },
    { "type": "control", "group": "form", "option": "detached" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "capsules", "equals": 1 },
    { "type": "control", "group": "form", "option": "attached" },
    { "type": "expect", "observable": "capsules", "equals": 0 },
    { "type": "control", "group": "state", "option": "windowed" },
    { "type": "control", "group": "edge", "option": "left" },
    { "type": "expect", "observable": "attached-left", "equals": true },
    { "type": "expect", "observable": "registration-ready", "equals": true },
    { "type": "control", "group": "edge", "option": "right" },
    { "type": "expect", "observable": "attached-right", "equals": true },
    { "type": "control", "group": "edge", "option": "top" },
    { "type": "expect", "observable": "attached-top", "equals": true },
    { "type": "control", "group": "edge", "option": "bottom" },
    { "type": "expect", "observable": "attached-bottom", "equals": true },
    { "type": "control", "group": "layer", "option": "short-child" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "nested", "equals": true },
    { "type": "expect", "observable": "parent-child-linked", "equals": true },
    { "type": "expect", "observable": "exact-seam", "equals": false },
    { "type": "control", "group": "layer", "option": "full-span-child" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": true },
    { "type": "control", "group": "edge", "option": "left" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": true },
    { "type": "control", "group": "edge", "option": "right" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": true },
    { "type": "control", "group": "edge", "option": "top" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": true },
    { "type": "control", "group": "layer", "option": "short-child" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": false },
    { "type": "control", "group": "edge", "option": "left" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": false },
    { "type": "control", "group": "edge", "option": "right" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "exact-seam", "equals": false }
  ]
}
