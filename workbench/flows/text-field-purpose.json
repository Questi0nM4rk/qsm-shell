{
  "version": 1,
  "key": "text-field-purpose",
  "target": { "story": "text-input" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "input-type", "equals": "text" },
    { "type": "expect", "observable": "purpose", "equals": "text" },
    { "type": "expect", "observable": "text", "equals": "Ada Lovelace" },
    { "type": "expect", "observable": "acceptable-input", "equals": true },
    { "type": "action", "name": "accept" },
    { "type": "expect", "observable": "accepted", "equals": 1 },
    { "type": "expectEvent", "event": "accepted", "origin": "component" },
    { "type": "action", "name": "clear" },
    { "type": "expect", "observable": "text", "equals": "" },
    { "type": "expectEvent", "event": "edited", "origin": "component" },
    { "type": "control", "group": "purpose", "option": "search" },
    { "type": "expect", "observable": "purpose", "equals": "search" },
    { "type": "expect", "observable": "leading-glyph", "equals": "search" },
    { "type": "expect", "observable": "input-type", "equals": "text" },
    { "type": "expect", "observable": "text", "equals": "volume" },
    { "type": "control", "group": "purpose", "option": "password" },
    { "type": "expect", "observable": "purpose", "equals": "password" },
    { "type": "expect", "observable": "trailing-action", "equals": "reveal" },
    { "type": "expect", "observable": "text", "equals": "hunter2" },
    { "type": "expect", "observable": "input-type", "equals": "password" },
    { "type": "expect", "observable": "revealed", "equals": false },
    { "type": "action", "name": "reveal" },
    { "type": "expect", "observable": "revealed", "equals": true },
    { "type": "expect", "observable": "input-type", "equals": "password" },
    { "type": "action", "name": "reveal" },
    { "type": "expect", "observable": "revealed", "equals": false },
    { "type": "control", "group": "purpose", "option": "number" },
    { "type": "expect", "observable": "purpose", "equals": "number" },
    { "type": "expect", "observable": "trailing-action", "equals": "unit" },
    { "type": "expect", "observable": "text", "equals": "42" },
    { "type": "expect", "observable": "input-type", "equals": "number" },
    { "type": "write", "text": "abc" },
    { "type": "expect", "observable": "acceptable-input", "equals": false },
    { "type": "action", "name": "accept" },
    { "type": "expect", "observable": "accepted", "equals": 1 },
    { "type": "write", "text": "42" },
    { "type": "expect", "observable": "acceptable-input", "equals": true },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "accepted", "equals": 2 },
    { "type": "control", "group": "mode", "option": "read-only" },
    { "type": "expect", "observable": "can-clear", "equals": false },
    { "type": "control", "group": "validity", "option": "failed" },
    { "type": "expect", "observable": "failed", "equals": true },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "can-accept", "equals": false },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "expect", "observable": "size", "equals": "lg" }
  ]
}
