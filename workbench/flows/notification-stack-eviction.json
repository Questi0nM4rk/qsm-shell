{
  "version": 1,
  "key": "notification-stack-eviction",
  "target": { "story": "notification-stack" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "count", "equals": 2 },
    { "type": "expect", "observable": "ids", "equals": "a,b" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "rendered", "equals": 2 },
    { "type": "control", "group": "arrival", "option": "arrive" },
    { "type": "expect", "observable": "evicting", "equals": 1 },
    { "type": "expect", "observable": "ids", "equals": "b,c" },
    { "type": "expect", "observable": "rendered", "equals": 3 },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "rendered", "equals": 2 },
    { "type": "control", "group": "window", "option": "one" },
    { "type": "expect", "observable": "evicting", "equals": 1 },
    { "type": "expect", "observable": "ids", "equals": "c" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "rendered", "equals": 1 },
    { "type": "control", "group": "window", "option": "two" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "ids", "equals": "b,c" },
    { "type": "control", "group": "arrival", "option": "expire-newest" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "ids", "equals": "a,b" },
    { "type": "control", "group": "arrival", "option": "expire-newest" },
    { "type": "expect", "observable": "evicting", "equals": 0 },
    { "type": "expect", "observable": "count", "equals": 1 },
    { "type": "expect", "observable": "ids", "equals": "a" }
  ]
}
