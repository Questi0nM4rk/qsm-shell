{
  "version": 1,
  "key": "data-capsule-pointer-keyboard",
  "target": { "story": "data-capsule" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "hovered", "equals": false },
    { "type": "expect", "observable": "keep-open", "equals": false },
    { "type": "pointer", "target": "capsule", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "await", "observable": "hovered", "equals": true },
    { "type": "expect", "observable": "keep-open", "equals": true },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "await", "observable": "hovered", "equals": false },
    { "type": "pointer", "target": "capsule", "event": "press", "x": 0.5, "y": 0.5 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.02, "y": 0.02 },
    { "type": "expect", "observable": "opened", "equals": 0 },
    { "type": "pointer", "target": "capsule", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expectEvent", "event": "activated", "origin": "component" },
    { "type": "expect", "observable": "opened", "equals": 1 },
    { "type": "expect", "observable": "focused", "equals": false },
    { "type": "key", "target": "capsule", "key": "Space" },
    { "type": "expect", "observable": "opened", "equals": 2 },
    { "type": "key", "target": "capsule", "key": "Enter" },
    { "type": "expect", "observable": "opened", "equals": 3 },
    { "type": "control", "group": "retention", "option": "no-hover-stay" },
    { "type": "pointer", "target": "capsule", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "await", "observable": "hovered", "equals": true },
    { "type": "expect", "observable": "keep-open", "equals": false },
    { "type": "control", "group": "availability", "option": "report-only" },
    { "type": "key", "target": "capsule", "key": "Space" },
    { "type": "pointer", "target": "capsule", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "opened", "equals": 3 },
    { "type": "control", "group": "availability", "option": "disabled" },
    { "type": "expect", "observable": "accepts-input", "equals": false },
    { "type": "expect", "observable": "can-activate", "equals": false }
  ]
}
