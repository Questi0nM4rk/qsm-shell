{
  "version": 1,
  "key": "menu-keyboard",
  "target": { "story": "menu" },
  "steps": [
    { "type": "reset" },
    { "type": "pointer", "target": "clear", "event": "click" },
    { "type": "expect", "observable": "current-index", "equals": -1 },
    { "type": "expect", "observable": "focus", "equals": "clear" },
    { "type": "expect", "observable": "tab-stop", "equals": "lock" },
    { "type": "key", "target": "scene", "key": "Tab" },
    { "type": "expect", "observable": "focus", "equals": "lock" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "key", "target": "scene", "key": "Down" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "expect", "observable": "focus", "equals": "power-off" },
    { "type": "expect", "observable": "tab-stop", "equals": "power-off" },
    { "type": "key", "target": "scene", "key": "Down" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "expect", "observable": "focus", "equals": "lock" },
    { "type": "key", "target": "scene", "key": "End" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "key", "target": "scene", "key": "Home" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "key", "target": "scene", "key": "Up" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "key", "target": "scene", "key": "Enter" },
    { "type": "expectEvent", "event": "row-activated", "origin": "component", "payload": { "id": "power-off" } },
    { "type": "expect", "observable": "activations", "equals": 1 },
    { "type": "key", "target": "scene", "key": "Home" },
    { "type": "key", "target": "scene", "key": "Space" },
    { "type": "expectEvent", "event": "row-activated", "origin": "component", "payload": { "id": "lock" } },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "key", "target": "scene", "key": "Tab" },
    { "type": "expect", "observable": "focus", "equals": "clear" },
    { "type": "key", "target": "scene", "key": "Backtab" },
    { "type": "expect", "observable": "focus", "equals": "lock" }
  ]
}
