{
  "version": 1,
  "key": "menu-stepping",
  "target": { "story": "menu" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "expect", "observable": "selected-lock", "equals": true },
    { "type": "expect", "observable": "selected-power-off", "equals": false },
    { "type": "control", "group": "selection", "option": "none" },
    { "type": "expect", "observable": "current-index", "equals": -1 },
    { "type": "expect", "observable": "selected-lock", "equals": false },
    { "type": "action", "name": "activate-current" },
    { "type": "expect", "observable": "activations", "equals": 0 },
    { "type": "control", "group": "selection", "option": "power-off" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "expect", "observable": "selected-power-off", "equals": true },
    { "type": "action", "name": "step-next" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "expect", "observable": "selected-lock", "equals": true },
    { "type": "expect", "observable": "selected-power-off", "equals": false },
    { "type": "action", "name": "step-next" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "action", "name": "step-previous" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "action", "name": "activate-current" },
    { "type": "expect", "observable": "activated-index", "equals": 1 },
    { "type": "expect", "observable": "activations", "equals": 1 },
    { "type": "expectEvent", "event": "activated" },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "action", "name": "step-last" },
    { "type": "expect", "observable": "current-index", "equals": 3 },
    { "type": "action", "name": "step-first" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "control", "group": "rows", "option": "modelled" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "row-count", "equals": 7 },
    { "type": "expect", "observable": "current-index", "equals": 4 },
    { "type": "expect", "observable": "selected-lock", "equals": true },
    { "type": "expect", "observable": "model-selected", "equals": "" },
    { "type": "action", "name": "step-previous" },
    { "type": "expect", "observable": "current-index", "equals": 2 },
    { "type": "expect", "observable": "model-selected", "equals": "Display settings" },
    { "type": "expect", "observable": "selected-lock", "equals": false },
    { "type": "action", "name": "step-first" },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "expect", "observable": "model-selected", "equals": "Audio settings" },
    { "type": "action", "name": "step-last" },
    { "type": "expect", "observable": "current-index", "equals": 6 },
    { "type": "expect", "observable": "selected-power-off", "equals": true },
    { "type": "action", "name": "activate-current" },
    { "type": "expect", "observable": "activated-index", "equals": 6 },
    { "type": "expect", "observable": "activations", "equals": 3 }
  ]
}
