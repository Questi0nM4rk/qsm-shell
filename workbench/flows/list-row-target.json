{
  "version": 1,
  "key": "list-row-target",
  "target": { "story": "list-row" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selectable", "equals": true },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "expect", "observable": "activations", "equals": 0 },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "activations", "equals": 1 },
    { "type": "expectEvent", "event": "activated" },
    { "type": "expect", "observable": "focused", "equals": true },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "expectEvent", "event": "activated" },
    { "type": "action", "name": "secondary-activate" },
    { "type": "expect", "observable": "secondary-activations", "equals": 1 },
    { "type": "expectEvent", "event": "secondary-activated" },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "control", "group": "target", "option": "report-only" },
    { "type": "expect", "observable": "selectable", "equals": false },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "control", "group": "target", "option": "interactive" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "selectable", "equals": false },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "activations", "equals": 2 },
    { "type": "control", "group": "structure", "option": "header" },
    { "type": "expect", "observable": "selectable", "equals": false },
    { "type": "control", "group": "structure", "option": "row" },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "control", "group": "target", "option": "interactive" },
    { "type": "expect", "observable": "selectable", "equals": true },
    { "type": "control", "group": "content", "option": "long" },
    { "type": "control", "group": "content", "option": "normal" },
    { "type": "control", "group": "selection", "option": "unselected" },
    { "type": "expect", "observable": "selected", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "activations", "equals": 3 }
  ]
}
