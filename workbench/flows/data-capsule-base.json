{
  "version": 1,
  "key": "data-capsule-base",
  "target": { "story": "data-capsule" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "environment-supported", "equals": true },
    { "type": "expect", "observable": "fullscreen", "equals": false },
    { "type": "expect", "observable": "shown", "equals": true },
    { "type": "pointer", "target": "capsule", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expectEvent", "event": "activated", "origin": "component" },
    { "type": "expect", "observable": "opened", "equals": 1 },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "opened", "equals": 2 },
    { "type": "control", "group": "edge", "option": "left" },
    { "type": "control", "group": "alignment", "option": "end" },
    { "type": "expect", "observable": "edge", "equals": "left" },
    { "type": "expect", "observable": "alignment", "equals": "end" },
    { "type": "control", "group": "orientation", "option": "vertical" },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "control", "group": "length", "option": "long" },
    { "type": "control", "group": "content", "option": "long" },
    { "type": "environment", "mode": "fullscreen" },
    { "type": "expect", "observable": "fullscreen", "equals": true },
    { "type": "expect", "observable": "opened", "equals": 2 },
    { "type": "control", "group": "content", "option": "empty" },
    { "type": "environment", "mode": "desktop" },
    { "type": "expect", "observable": "fullscreen", "equals": false },
    { "type": "control", "group": "availability", "option": "report-only" },
    { "type": "expect", "observable": "accepts-input", "equals": true },
    { "type": "expect", "observable": "can-activate", "equals": false },
    { "type": "pointer", "target": "capsule", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "opened", "equals": 2 },
    { "type": "control", "group": "availability", "option": "disabled" },
    { "type": "expect", "observable": "accepts-input", "equals": false },
    { "type": "expect", "observable": "opened", "equals": 2 },
    { "type": "control", "group": "availability", "option": "openable" },
    { "type": "control", "group": "lifetime", "option": "persistent" },
    { "type": "action", "name": "present" },
    { "type": "expect", "observable": "armed", "equals": false },
    { "type": "control", "group": "lifetime", "option": "timed" },
    { "type": "action", "name": "present" },
    { "type": "expect", "observable": "armed", "equals": true },
    { "type": "action", "name": "reset" },
    { "type": "expect", "observable": "shown", "equals": false },
    { "type": "expect", "observable": "armed", "equals": false },
    { "type": "expect", "observable": "expired", "equals": 0 },
    { "type": "action", "name": "present" },
    { "type": "expect", "observable": "armed", "equals": true },
    { "type": "await", "observable": "expired", "equals": 1 },
    { "type": "expectEvent", "event": "timeout-requested", "origin": "component" },
    { "type": "expect", "observable": "shown", "equals": false },
    { "type": "action", "name": "present" },
    { "type": "expect", "observable": "shown", "equals": true },
    { "type": "expect", "observable": "armed", "equals": true },
    { "type": "action", "name": "hide" },
    { "type": "expect", "observable": "armed", "equals": false },
    { "type": "expect", "observable": "expired", "equals": 1 }
  ]
}
