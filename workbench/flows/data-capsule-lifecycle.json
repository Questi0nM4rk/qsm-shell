{
  "version": 1,
  "key": "data-capsule-lifecycle",
  "target": { "composition": "compositions/capsule-sound.json" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "pointer", "node": "sound", "target": "slider", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "expect", "node": "capsule", "observable": "keep-open", "equals": true },
    { "type": "action", "node": "capsule", "name": "cancel-timeout" },
    { "type": "expect", "node": "capsule", "observable": "remaining-time", "equals": 0 },
    { "type": "action", "node": "capsule", "name": "open" },
    { "type": "control", "node": "capsule", "group": "retention", "option": "expire-while-hovered" },
    { "type": "expect", "node": "capsule", "observable": "keep-open", "equals": false },
    { "type": "await", "node": "capsule", "observable": "open", "equals": false },
    { "type": "expectEvent", "node": "capsule", "event": "timeout-requested", "origin": "component" },
    { "type": "action", "node": "capsule", "name": "open" },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "action", "node": "capsule", "name": "cancel-timeout" },
    { "type": "expect", "node": "capsule", "observable": "remaining-time", "equals": 0 },
    { "type": "action", "node": "capsule", "name": "close" },
    { "type": "await", "node": "capsule", "observable": "present", "equals": false },
    { "type": "expect", "node": "capsule", "observable": "accepts-input", "equals": false },
    { "type": "action", "node": "sound", "name": "toggle-mute" },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "component", "payload": { "muted": true } },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": true },
    { "type": "action", "node": "sound", "name": "toggle-mute" },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "component", "payload": { "muted": false } },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "environment", "mode": "fullscreen" },
    { "type": "expect", "node": "capsule", "observable": "fullscreen", "equals": true },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "environment", "mode": "desktop" },
    { "type": "expect", "node": "capsule", "observable": "fullscreen", "equals": false },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "pointer", "node": "sound", "target": "slider", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "component", "payload": { "level": 47 } },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 47 },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "await", "node": "capsule", "observable": "open", "equals": false },
    { "type": "expectEvent", "node": "capsule", "event": "timeout-requested", "origin": "component" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 47 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "action", "node": "capsule", "name": "open" },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "action", "node": "capsule", "name": "cancel-timeout" },
    { "type": "expect", "node": "capsule", "observable": "remaining-time", "equals": 0 },
    { "type": "reset" },
    { "type": "control", "node": "capsule", "group": "retention", "option": "expire-while-hovered" },
    { "type": "await", "node": "capsule", "observable": "open", "equals": false },
    { "type": "expectEvent", "node": "capsule", "event": "timeout-requested", "origin": "component" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false }
  ]
}
