{
  "version": 1,
  "key": "notification-card-dismiss",
  "target": { "story": "notification" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "dismiss-count", "equals": 0 },
    { "type": "pointer", "target": "card", "event": "move", "x": 0.937, "y": 0.261 },
    { "type": "expect", "observable": "hovered", "equals": true },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.937, "y": 0.261 },
    { "type": "expectEvent", "event": "dismissed", "origin": "component" },
    { "type": "expect", "observable": "dismiss-count", "equals": 1 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 0 },
    { "type": "pointer", "target": "card", "event": "click", "button": "middle", "x": 0.5, "y": 0.6 },
    { "type": "expect", "observable": "dismiss-count", "equals": 2 },
    { "type": "action", "name": "dismiss" },
    { "type": "expect", "observable": "dismiss-count", "equals": 3 },
    { "type": "action", "name": "focus" },
    { "type": "expect", "observable": "focused", "equals": true },
    { "type": "key", "target": "card", "key": "Delete" },
    { "type": "expect", "observable": "dismiss-count", "equals": 4 },
    { "type": "key", "target": "card", "key": "Escape" },
    { "type": "expect", "observable": "dismiss-count", "equals": 5 },
    { "type": "pointer", "target": "scene", "event": "press", "x": 0.772, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.483, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.152, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.152, "y": 0.29 },
    { "type": "expect", "observable": "dismiss-count", "equals": 6 },
    { "type": "awaitIdle" },
    { "type": "pointer", "target": "scene", "event": "press", "x": 0.483, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.4, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.317, "y": 0.29 },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.317, "y": 0.29 },
    { "type": "expect", "observable": "dismiss-count", "equals": 6 },
    { "type": "awaitIdle" },
    { "type": "control", "group": "input", "option": "retiring" },
    { "type": "pointer", "target": "card", "event": "click", "button": "middle", "x": 0.5, "y": 0.6 },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.937, "y": 0.261 },
    { "type": "action", "name": "dismiss" },
    { "type": "expect", "observable": "dismiss-count", "equals": 6 }
  ]
}
