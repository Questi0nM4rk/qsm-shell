{
  "version": 1,
  "key": "capsule-toggle",
  "target": { "story": "capsule" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "active", "equals": true },
    { "type": "expect", "observable": "height", "equals": 32 },
    { "type": "pointer", "target": "capsule", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "await", "observable": "hovered", "equals": true },
    { "type": "pointer", "target": "capsule", "event": "press", "x": 0.5, "y": 0.5 },
    { "type": "await", "observable": "pressed", "equals": true },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "await", "observable": "pressed", "equals": false },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.02, "y": 0.02 },
    { "type": "expect", "observable": "active", "equals": true },
    { "type": "pointer", "target": "capsule", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expectEvent", "event": "clicked", "origin": "component", "payload": { "active": false } },
    { "type": "expect", "observable": "active", "equals": false },
    { "type": "expect", "observable": "focused", "equals": false },
    { "type": "key", "target": "capsule", "key": "Space" },
    { "type": "expect", "observable": "active", "equals": true },
    { "type": "key", "target": "capsule", "key": "Enter" },
    { "type": "expect", "observable": "active", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "active", "equals": true },
    { "type": "control", "group": "content", "option": "glyph-only" },
    { "type": "await", "observable": "width", "equals": 32 },
    { "type": "control", "group": "content", "option": "long" },
    { "type": "control", "group": "width", "option": "narrow" },
    { "type": "await", "observable": "width", "equals": 95 },
    { "type": "control", "group": "ground", "option": "card" },
    { "type": "expect", "observable": "raised", "equals": true },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "await", "observable": "hovered", "equals": false },
    { "type": "expect", "observable": "active", "equals": true }
  ]
}
