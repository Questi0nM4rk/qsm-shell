{
  "version": 1,
  "key": "notification-stack-native",
  "target": { "story": "notification-stack" },
  "steps": [
    { "type": "reset" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ids", "equals": "a,b" },
    { "type": "pointer", "target": "newest", "event": "move" },
    { "type": "await", "observable": "newest-hovered", "equals": true },
    { "type": "await", "observable": "newest-expanded", "equals": true },
    { "type": "awaitIdle" },
    { "type": "control", "group": "arrival", "option": "same-id-update" },
    { "type": "expect", "observable": "replacement-kept-row", "equals": true },
    { "type": "expect", "observable": "newest-expanded", "equals": true },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.05, "y": 0.8 },
    { "type": "await", "observable": "newest-hovered", "equals": false },
    { "type": "awaitIdle" },
    { "type": "control", "group": "arrival", "option": "arrive" },
    { "type": "expect", "observable": "evicting", "equals": 1 },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ids", "equals": "b,c" },
    { "type": "pointer", "target": "oldest", "event": "click", "button": "middle" },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component", "payload": { "id": "b" } },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ids", "equals": "a,c" },
    { "type": "control", "group": "arrival", "option": "clear" },
    { "type": "expect", "observable": "source-count", "equals": 0 },
    { "type": "expect", "observable": "count", "equals": 2 },
    { "type": "expect", "observable": "eligible", "equals": "0,0" },
    { "type": "await", "observable": "rollout-visible", "equals": false },
    { "type": "expect", "observable": "rendered", "equals": 0 },
    { "type": "control", "group": "arrival", "option": "arrive" },
    { "type": "awaitIdle" },
    { "type": "control", "group": "arrival", "option": "arrive-during-retreat" },
    { "type": "await", "observable": "retreat-arrivals", "equals": 1 },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "source-count", "equals": 1 },
    { "type": "pointer", "target": "newest", "event": "move" },
    { "type": "awaitIdle" },
    { "type": "pointer", "target": "newest", "event": "click", "button": "middle", "y": 0.1 },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component", "payload": { "id": "e" } },
    { "type": "expect", "observable": "source-count", "equals": 0 },
    { "type": "expect", "observable": "count", "equals": 1 },
    { "type": "await", "observable": "rollout-visible", "equals": false },
    { "type": "expect", "observable": "rendered", "equals": 0 },
    { "type": "control", "group": "arrival", "option": "arrive" },
    { "type": "awaitIdle" },
    { "type": "pointer", "target": "newest", "event": "move", "x": 0.85, "y": 0.1 },
    { "type": "awaitIdle" },
    { "type": "pointer", "target": "newest", "event": "press", "x": 0.85, "y": 0.1 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.5, "y": 0.032 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.31, "y": 0.032 },
    { "type": "await", "observable": "newest-drag-active", "equals": true },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.31, "y": 0.032 },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component", "payload": { "id": "f" } },
    { "type": "await", "observable": "source-count", "equals": 0 },
    { "type": "await", "observable": "rollout-visible", "equals": false },
    { "type": "expect", "observable": "rendered", "equals": 0 }
  ]
}
