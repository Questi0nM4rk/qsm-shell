{
  "version": 1,
  "key": "scroll-cue-overflow",
  "target": { "story": "scroll-cue-short" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "overflows", "equals": true },
    { "type": "expect", "observable": "fade", "equals": true },
    { "type": "expect", "observable": "indicator", "equals": true },
    { "type": "expect", "observable": "at-start", "equals": true },
    { "type": "expect", "observable": "fade-start", "equals": 0 },
    { "type": "expect", "observable": "fade-end", "equals": 20 },
    { "type": "pointer", "target": "list", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "await", "observable": "at-start", "equals": false },
    { "type": "expect", "observable": "fade-start", "equals": 20 },
    { "type": "expect", "observable": "fade-end", "equals": 20 },
    { "type": "action", "name": "to-end" },
    { "type": "expect", "observable": "at-end", "equals": true },
    { "type": "expect", "observable": "fade-start", "equals": 20 },
    { "type": "expect", "observable": "fade-end", "equals": 0 },
    { "type": "action", "name": "to-start" },
    { "type": "expect", "observable": "fade-start", "equals": 0 },
    { "type": "control", "group": "viewport", "option": "full" },
    { "type": "expect", "observable": "fade-end", "equals": 32 },
    { "type": "control", "group": "axis", "option": "horizontal" },
    { "type": "expect", "observable": "fade-end", "equals": 32 },
    { "type": "action", "name": "to-end" },
    { "type": "expect", "observable": "fade-start", "equals": 32 },
    { "type": "expect", "observable": "fade-end", "equals": 0 },
    { "type": "control", "group": "axis", "option": "vertical" },
    { "type": "control", "group": "content", "option": "fitting" },
    { "type": "expect", "observable": "overflows", "equals": false },
    { "type": "expect", "observable": "fade-start", "equals": 0 },
    { "type": "expect", "observable": "fade-end", "equals": 0 },
    { "type": "control", "group": "content", "option": "overflowing" },
    { "type": "expect", "observable": "overflows", "equals": true },
    { "type": "control", "group": "fade", "option": "off" },
    { "type": "expect", "observable": "fade", "equals": false },
    { "type": "expect", "observable": "overflows", "equals": true },
    { "type": "control", "group": "indicator", "option": "off" },
    { "type": "expect", "observable": "indicator", "equals": false },
    { "type": "expect", "observable": "overflows", "equals": true }
  ]
}
