{
  "version": 1,
  "key": "notification-center-pointer",
  "target": { "story": "notification-center" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "count", "equals": 3 },
    { "type": "expect", "observable": "unread-count", "equals": 3 },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.069, "y": 0.358 },
    { "type": "expect", "observable": "expanded", "equals": true },
    { "type": "expect", "observable": "activations", "equals": 0 },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.069, "y": 0.358 },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.573, "y": 0.396 },
    { "type": "expectEvent", "event": "activated", "origin": "component" },
    { "type": "expect", "observable": "activations", "equals": 1 },
    { "type": "expect", "observable": "unread-count", "equals": 2 },
    { "type": "expect", "observable": "count", "equals": 3 },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.908, "y": 0.333 },
    { "type": "expectEvent", "event": "hover-changed", "origin": "component", "payload": { "hovered": true } },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.908, "y": 0.333 },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component" },
    { "type": "expect", "observable": "dismissed", "equals": 1 },
    { "type": "expect", "observable": "last-dismissed", "equals": "Build finished" },
    { "type": "expect", "observable": "count", "equals": 2 },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.807, "y": 0.175 },
    { "type": "expectEvent", "event": "dnd-toggled", "origin": "component", "payload": { "dnd": true } },
    { "type": "expect", "observable": "dnd", "equals": true },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.807, "y": 0.175 },
    { "type": "expect", "observable": "dnd", "equals": false },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.917, "y": 0.175 },
    { "type": "expect", "observable": "clears", "equals": 0 },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.917, "y": 0.175 },
    { "type": "expectEvent", "event": "clear-requested", "origin": "component" },
    { "type": "expect", "observable": "clears", "equals": 1 },
    { "type": "expect", "observable": "count", "equals": 0 }
  ]
}
