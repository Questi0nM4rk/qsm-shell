{
  "version": 1,
  "key": "stat-ring-form-value",
  "target": { "story": "stat-ring" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "value", "equals": 0.42 },
    { "type": "await", "observable": "shown", "equals": 0.42 },
    { "type": "expect", "observable": "reading", "equals": "42%" },
    { "type": "expect", "observable": "label", "equals": "CPU" },
    { "type": "expect", "observable": "accessible-name", "equals": "CPU, 42%" },
    { "type": "expect", "observable": "start-angle", "equals": -225 },
    { "type": "expect", "observable": "sweep-angle", "equals": 270 },
    { "type": "control", "group": "form", "option": "closed" },
    { "type": "expect", "observable": "start-angle", "equals": -90 },
    { "type": "expect", "observable": "sweep-angle", "equals": 360 },
    { "type": "control", "group": "form", "option": "open" },
    { "type": "expect", "observable": "start-angle", "equals": -225 },
    { "type": "expect", "observable": "sweep-angle", "equals": 270 },
    { "type": "control", "group": "value", "option": "none" },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "await", "observable": "shown", "equals": 0 },
    { "type": "control", "group": "value", "option": "full" },
    { "type": "expect", "observable": "value", "equals": 1 },
    { "type": "await", "observable": "shown", "equals": 1 },
    { "type": "control", "group": "value", "option": "part" },
    { "type": "expect", "observable": "value", "equals": 0.42 },
    { "type": "await", "observable": "shown", "equals": 0.42 },
    { "type": "expect", "observable": "diameter", "equals": 150 },
    { "type": "expect", "observable": "reading-size", "equals": 22 },
    { "type": "control", "group": "size", "option": "sm" },
    { "type": "expect", "observable": "diameter", "equals": 64 },
    { "type": "expect", "observable": "reading-size", "equals": 12 },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "expect", "observable": "diameter", "equals": 240 },
    { "type": "expect", "observable": "reading-size", "equals": 28 },
    { "type": "control", "group": "size", "option": "md" },
    { "type": "control", "group": "content", "option": "reading-only" },
    { "type": "expect", "observable": "label", "equals": "" },
    { "type": "expect", "observable": "reading", "equals": "42%" },
    { "type": "expect", "observable": "accessible-name", "equals": "42%" },
    { "type": "control", "group": "content", "option": "bare" },
    { "type": "expect", "observable": "reading", "equals": "" },
    { "type": "expect", "observable": "accessible-name", "equals": "" },
    { "type": "control", "group": "content", "option": "full" },
    { "type": "expect", "observable": "reading", "equals": "42%" },
    { "type": "expect", "observable": "label", "equals": "CPU" }
  ]
