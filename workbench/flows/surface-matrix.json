{
  "version": 1,
  "key": "surface-matrix",
  "target": { "story": "surface" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "expect", "observable": "hovered", "equals": false },
    { "type": "expect", "observable": "grown", "equals": false },
    { "type": "pointer", "target": "body", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "hovered", "equals": true },
    { "type": "await", "observable": "grown", "equals": true },
    { "type": "pointer", "target": "body", "event": "press", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "pressed", "equals": true },
    { "type": "pointer", "target": "body", "event": "release", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "pressed", "equals": false },
    { "type": "expectEvent", "event": "clicked", "origin": "component", "payload": { "selected": false } },
    { "type": "expect", "observable": "selected", "equals": false },
    { "type": "expect", "observable": "focused", "equals": false },
    { "type": "key", "target": "body", "key": "Space" },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "key", "target": "body", "key": "Enter" },
    { "type": "expect", "observable": "selected", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "pointer", "target": "body", "event": "press", "x": 0.5, "y": 0.5 },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "await", "observable": "pressed", "equals": false },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.02, "y": 0.02 },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "control", "group": "wall", "option": "left" },
    { "type": "expect", "observable": "wall", "equals": "left" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "expect", "observable": "hovered", "equals": false },
    { "type": "expect", "observable": "selected", "equals": true }
  ]
}
