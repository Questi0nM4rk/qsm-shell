{
  "version": 1,
  "key": "badge-presence",
  "target": {
    "story": "badge"
  },
  "steps": [
    {
      "type": "reset"
    },
    {
      "type": "expect",
      "observable": "tone",
      "equals": "warning"
    },
    {
      "type": "control",
      "group": "tone",
      "option": "danger"
    },
    {
      "type": "expect",
      "observable": "tone",
      "equals": "danger"
    },
    {
      "type": "control",
      "group": "weight",
      "option": "filled"
    },
    {
      "type": "expect",
      "observable": "filled",
      "equals": true
    },
    {
      "type": "control",
      "group": "weight",
      "option": "tinted"
    },
    {
      "type": "expect",
      "observable": "filled",
      "equals": false
    },
    {
      "type": "control",
      "group": "presence",
      "option": "reading"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "visible",
      "equals": true
    },
    {
      "type": "expect",
      "observable": "icon",
      "equals": ""
    },
    {
      "type": "expect",
      "observable": "dot",
      "equals": false
    },
    {
      "type": "expect",
      "observable": "width",
      "equals": 32
    },
    {
      "type": "control",
      "group": "presence",
      "option": "count-120"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "width",
      "equals": 32
    },
    {
      "type": "control",
      "group": "presence",
      "option": "long"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "width",
      "equals": 128
    },
    {
      "type": "expect",
      "observable": "height",
      "equals": 16
    },
    {
      "type": "control",
      "group": "presence",
      "option": "glyph"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "visible",
      "equals": true
    },
    {
      "type": "expect",
      "observable": "icon",
      "equals": "check"
    },
    {
      "type": "expect",
      "observable": "dot",
      "equals": false
    },
    {
      "type": "expect",
      "observable": "width",
      "equals": 16
    },
    {
      "type": "control",
      "group": "presence",
      "option": "dot"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "visible",
      "equals": true
    },
    {
      "type": "expect",
      "observable": "icon",
      "equals": ""
    },
    {
      "type": "expect",
      "observable": "dot",
      "equals": true
    },
    {
      "type": "expect",
      "observable": "width",
      "equals": 8
    },
    {
      "type": "control",
      "group": "presence",
      "option": "empty"
    },
    {
      "type": "awaitIdle"
    },
    {
      "type": "expect",
      "observable": "visible",
      "equals": false
    }
  ]
}
