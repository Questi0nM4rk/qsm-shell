{
  "version": 1,
  "key": "radio-select",
  "target": { "story": "radio" },
  "steps": [
    { "type": "reset" },
    { "type": "control", "group": "selected", "option": "none" },
    { "type": "expect", "observable": "selected", "equals": -1 },
    { "type": "pointer", "target": "second", "event": "click" },
    { "type": "expectEvent", "event": "selection-requested", "origin": "component", "payload": { "index": 1 } },
    { "type": "expect", "observable": "selected", "equals": 1 },
    { "type": "expect", "observable": "accessible-checked", "equals": 1 },
    { "type": "action", "name": "select-second" },
    { "type": "expect", "observable": "selected", "equals": 1 },
    { "type": "pointer", "target": "first", "event": "click" },
    { "type": "expectEvent", "event": "selection-requested", "origin": "component", "payload": { "index": 0 } },
    { "type": "expect", "observable": "selected", "equals": 0 },
    { "type": "key", "target": "first", "key": "Tab" },
    { "type": "key", "target": "second", "key": "Space" },
    { "type": "expectEvent", "event": "selection-requested", "origin": "component", "payload": { "index": 1 } },
    { "type": "expect", "observable": "selected", "equals": 1 },
    { "type": "key", "target": "second", "key": "Tab" },
    { "type": "key", "target": "third", "key": "Enter" },
    { "type": "expectEvent", "event": "selection-requested", "origin": "component", "payload": { "index": 2 } },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "control", "group": "second-option", "option": "unavailable" },
    { "type": "action", "name": "select-second" },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "action", "name": "select-first" },
    { "type": "expect", "observable": "selected", "equals": 2 }
  ]
}
