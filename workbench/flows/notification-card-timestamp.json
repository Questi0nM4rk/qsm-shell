{
  "version": 1,
  "key": "notification-card-timestamp",
  "target": { "story": "notification" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "expanded", "equals": true },
    { "type": "expect", "observable": "archived", "equals": false },
    { "type": "expect", "observable": "timestamp", "equals": "3m ago" },
    { "type": "expect", "observable": "icon-name", "equals": "bell" },
    { "type": "control", "group": "urgency", "option": "critical" },
    { "type": "expect", "observable": "icon-name", "equals": "alert-triangle" },
    { "type": "control", "group": "urgency", "option": "low" },
    { "type": "expect", "observable": "icon-name", "equals": "moon" },
    { "type": "control", "group": "archive", "option": "archived" },
    { "type": "expect", "observable": "archived", "equals": true },
    { "type": "expect", "observable": "timestamp", "equals": "14:05" },
    { "type": "control", "group": "archive", "option": "live" },
    { "type": "expect", "observable": "archived", "equals": false },
    { "type": "expect", "observable": "timestamp", "equals": "3m ago" },
    { "type": "control", "group": "expansion", "option": "hover" },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "expect", "observable": "timestamp", "equals": "" },
    { "type": "control", "group": "expansion", "option": "pinned" },
    { "type": "expect", "observable": "expanded", "equals": true },
    { "type": "control", "group": "swatch", "option": "colour" },
    { "type": "expect", "observable": "has-swatch", "equals": true },
    { "type": "control", "group": "swatch", "option": "none" },
    { "type": "expect", "observable": "has-swatch", "equals": false },
    { "type": "action", "name": "first-action" },
    { "type": "expectEvent", "event": "action-triggered", "origin": "component" },
    { "type": "expect", "observable": "last-action", "equals": "reboot" },
    { "type": "control", "group": "archive", "option": "archived" },
    { "type": "action", "name": "second-action" },
    { "type": "expect", "observable": "last-action", "equals": "reboot" },
    { "type": "control", "group": "archive", "option": "live" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "action", "name": "second-action" },
    { "type": "action", "name": "dismiss" },
    { "type": "expect", "observable": "last-action", "equals": "reboot" },
    { "type": "expect", "observable": "dismissed", "equals": 0 },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "action", "name": "second-action" },
    { "type": "expect", "observable": "last-action", "equals": "later" },
    { "type": "action", "name": "dismiss" },
    { "type": "expectEvent", "event": "dismissed", "origin": "component" },
    { "type": "expect", "observable": "dismissed", "equals": 1 },
    { "type": "expect", "observable": "present", "equals": false }
  ]
}
