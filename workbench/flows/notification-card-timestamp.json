{
  "version": 1,
  "key": "notification-card-timestamp",
  "target": { "story": "notification" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "archived", "equals": false },
    { "type": "expect", "observable": "timestamp", "equals": "3m ago" },
    { "type": "expect", "observable": "icon-name", "equals": "bell" },
    { "type": "control", "group": "urgency", "option": "critical" },
    { "type": "expect", "observable": "icon-name", "equals": "alert-triangle" },
    { "type": "control", "group": "urgency", "option": "low" },
    { "type": "expect", "observable": "icon-name", "equals": "info" },
    { "type": "control", "group": "record", "option": "archived" },
    { "type": "expect", "observable": "archived", "equals": true },
    { "type": "expect", "observable": "timestamp", "equals": "2h ago" },
    { "type": "control", "group": "record", "option": "live" },
    { "type": "expect", "observable": "archived", "equals": false },
    { "type": "expect", "observable": "timestamp", "equals": "3m ago" },
    { "type": "expect", "observable": "has-swatch", "equals": false },
    { "type": "control", "group": "lead", "option": "swatch" },
    { "type": "expect", "observable": "has-swatch", "equals": true },
    { "type": "control", "group": "lead", "option": "image" },
    { "type": "expect", "observable": "has-swatch", "equals": false },
    { "type": "control", "group": "lead", "option": "glyph" },
    { "type": "control", "group": "surface", "option": "list" },
    { "type": "control", "group": "body", "option": "long" },
    { "type": "control", "group": "record", "option": "archived" },
    { "type": "action", "name": "first-action" },
    { "type": "expect", "observable": "last-action", "equals": "" },
    { "type": "control", "group": "record", "option": "live" },
    { "type": "pointer", "target": "card", "event": "click", "x": 0.06, "y": 0.2 },
    { "type": "action", "name": "first-action" },
    { "type": "expectEvent", "event": "action-invoked", "origin": "component", "payload": { "action": "mark-read" } },
    { "type": "expect", "observable": "last-action", "equals": "mark-read" }
  ]
}
