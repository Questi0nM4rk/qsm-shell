{
  "version": 1,
  "key": "shell-border-registries",
  "target": { "story": "shell-border" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "bulges", "equals": 1 },
    { "type": "expect", "observable": "hit-regions", "equals": 1 },
    { "type": "control", "group": "hit", "option": "withheld" },
    { "type": "expect", "observable": "hit-regions", "equals": 0 },
    { "type": "expect", "observable": "bulges", "equals": 1 },
    { "type": "control", "group": "hit", "option": "registered" },
    { "type": "expect", "observable": "hit-regions", "equals": 1 },
    { "type": "control", "group": "state", "option": "fullscreen" },
    { "type": "control", "group": "form", "option": "detached" },
    { "type": "expect", "observable": "capsules", "equals": 1 },
    { "type": "control", "group": "form", "option": "attached" },
    { "type": "expect", "observable": "capsules", "equals": 0 },
    { "type": "action", "name": "add-capsule" },
    { "type": "expect", "observable": "capsules", "equals": 1 },
    { "type": "action", "name": "remove-capsule" },
    { "type": "expect", "observable": "capsules", "equals": 0 },
    { "type": "control", "group": "policy", "option": "filtered" },
    { "type": "expect", "observable": "hit-regions", "equals": 0 },
    { "type": "expect", "observable": "bulges", "equals": 0 },
    { "type": "control", "group": "policy", "option": "all" },
    { "type": "expect", "observable": "hit-regions", "equals": 1 },
    { "type": "control", "group": "mode", "option": "suppressed" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "suppressed", "equals": true },
    { "type": "expect", "observable": "revealed", "equals": true },
    { "type": "expect", "observable": "bulges", "equals": 0 },
    { "type": "expect", "observable": "hit-regions", "equals": 0 }
  ]
}
