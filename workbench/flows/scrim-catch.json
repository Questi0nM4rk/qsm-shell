{
  "version": 1,
  "key": "scrim-catch",
  "target": { "story": "scrim" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "shown", "equals": true },
    { "type": "pointer", "target": "ground-row", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "ground-hovered", "equals": false },
    { "type": "pointer", "target": "ground-list", "event": "wheel", "dx": 0, "dy": -240 },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ground-scrolled", "equals": false },
    { "type": "control", "group": "dismissal", "option": "refused" },
    { "type": "pointer", "target": "ground-row", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "ground-activations", "equals": 0 },
    { "type": "expect", "observable": "dismissals", "equals": 0 },
    { "type": "control", "group": "dismissal", "option": "allowed" },
    { "type": "pointer", "target": "ground-row", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expectEvent", "event": "dismissed", "origin": "component" },
    { "type": "expect", "observable": "dismissals", "equals": 1 },
    { "type": "expect", "observable": "shown", "equals": false },
    { "type": "pointer", "target": "ground-row", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "ground-activations", "equals": 0 },
    { "type": "await", "observable": "scrim-visible", "equals": false },
    { "type": "pointer", "target": "ground-row", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "ground-activations", "equals": 1 },
    { "type": "pointer", "target": "ground-list", "event": "wheel", "dx": 0, "dy": -240 },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ground-scrolled", "equals": true }
  ]
}
