{
  "version": 1,
  "key": "spinbox-pointer-keys",
  "target": { "story": "spin-box" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "expect", "observable": "text", "equals": "42.5" },
    { "type": "expect", "observable": "focused", "equals": false },
    { "type": "pointer", "target": "spinbox", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "pointer", "target": "spinbox", "event": "click" },
    { "type": "expect", "observable": "focused", "equals": true },
    { "type": "expect", "observable": "focus-ring", "equals": false },
    { "type": "pointer", "target": "spinbox", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expect", "observable": "value", "equals": 43 },
    { "type": "expectEvent", "event": "value-modified", "origin": "component", "payload": { "value": 43 } },
    { "type": "pointer", "target": "spinbox", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "key", "target": "spinbox", "key": "Up" },
    { "type": "expect", "observable": "value", "equals": 43 },
    { "type": "key", "target": "spinbox", "key": "Down" },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "pointer", "target": "increase", "event": "click" },
    { "type": "expect", "observable": "value", "equals": 43 },
    { "type": "expectEvent", "event": "value-modified", "origin": "component", "payload": { "value": 43 } },
    { "type": "pointer", "target": "decrease", "event": "click" },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "key", "target": "spinbox", "key": "End" },
    { "type": "expect", "observable": "value", "equals": 42.5 },
    { "type": "control", "group": "typing", "option": "off" },
    { "type": "key", "target": "spinbox", "key": "Home" },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "expect", "observable": "can-decrease", "equals": false },
    { "type": "key", "target": "spinbox", "key": "End" },
    { "type": "expect", "observable": "value", "equals": 100 },
    { "type": "expect", "observable": "can-increase", "equals": false },
    { "type": "control", "group": "typing", "option": "on" },
    { "type": "pointer", "target": "spinbox", "event": "click" },
    { "type": "key", "target": "spinbox", "key": "End" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "key", "target": "spinbox", "key": "Backspace" },
    { "type": "write", "target": "spinbox", "text": "7.5" },
    { "type": "expect", "observable": "typed-text", "equals": "7.5" },
    { "type": "key", "target": "spinbox", "key": "Enter" },
    { "type": "expect", "observable": "value", "equals": 7.5 },
    { "type": "expectEvent", "event": "value-modified", "origin": "component", "payload": { "value": 7.5 } },
    { "type": "expect", "observable": "text", "equals": "7.5" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "can-increase", "equals": false }
  ]
}
