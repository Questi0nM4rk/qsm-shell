{
  "version": 1,
  "key": "notification-stack-primary",
  "target": { "story": "notification-stack" },
  "steps": [
    { "type": "reset" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "ids", "equals": "a,b" },
    { "type": "pointer", "target": "newest", "event": "move", "x": 0.5, "y": 0.5 },
    { "type": "await", "observable": "newest-hovered", "equals": true },
    { "type": "expectEvent", "event": "hover-changed", "origin": "component", "payload": { "id": "b", "hovered": true } },
    { "type": "pointer", "target": "newest", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expectEvent", "event": "primary-triggered", "origin": "component", "payload": { "id": "b" } },
    { "type": "expect", "observable": "primary-callback-count", "equals": 1 },
    { "type": "action", "name": "focus-newest" },
    { "type": "expect", "observable": "newest-focused", "equals": true },
    { "type": "key", "target": "newest", "key": "Enter" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 2 },
    { "type": "key", "target": "newest", "key": "Space" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 3 },
    { "type": "action", "name": "activate-newest-primary" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 4 },
    { "type": "expect", "observable": "primary-callback-ids", "equals": "b,b,b,b" },
    { "type": "control", "group": "primary-action", "option": "no-default" },
    { "type": "pointer", "target": "newest", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 4 },
    { "type": "control", "group": "primary-action", "option": "default-provided" },
    { "type": "pointer", "target": "newest", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "primary-callback-count", "equals": 5 },
    { "type": "control", "group": "arrival", "option": "clear" },
    { "type": "expect", "observable": "eligible", "equals": "0,0" },
    { "type": "expect", "observable": "primary-callback-count", "equals": 5 }
  ]
}
