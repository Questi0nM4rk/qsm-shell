{
  "version": 1,
  "key": "action-tile-arm",
  "target": { "story": "action-tile" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selected-index", "equals": -1 },
    { "type": "expect", "observable": "armed-role", "equals": "" },
    { "type": "expect", "observable": "tile-width", "equals": 96 },
    { "type": "expect", "observable": "tile-height", "equals": 72 },
    { "type": "expect", "observable": "lock-name", "equals": "Lock" },
    { "type": "pointer", "target": "shutdown", "event": "move" },
    { "type": "expect", "observable": "selected-index", "equals": 4 },
    { "type": "expect", "observable": "shutdown-selected", "equals": true },
    { "type": "pointer", "target": "shutdown", "event": "click" },
    { "type": "expectEvent", "event": "activated", "origin": "component" },
    { "type": "expect", "observable": "armed-role", "equals": "shutdown" },
    { "type": "expect", "observable": "shutdown-label", "equals": "Shut down?" },
    { "type": "expect", "observable": "fired-count", "equals": 0 },
    { "type": "pointer", "target": "lock", "event": "move" },
    { "type": "expect", "observable": "armed-role", "equals": "" },
    { "type": "expect", "observable": "shutdown-label", "equals": "Shut down" },
    { "type": "pointer", "target": "shutdown", "event": "click" },
    { "type": "expect", "observable": "armed-role", "equals": "shutdown" },
    { "type": "key", "target": "shutdown", "key": "Space" },
    { "type": "expect", "observable": "fired-count", "equals": 1 },
    { "type": "expectEvent", "event": "fired", "origin": "component" },
    { "type": "expect", "observable": "fired-role", "equals": "shutdown" },
    { "type": "expect", "observable": "armed-role", "equals": "" },
    { "type": "pointer", "target": "lock", "event": "click" },
    { "type": "expect", "observable": "fired-count", "equals": 2 },
    { "type": "expect", "observable": "fired-role", "equals": "lock" },
    { "type": "key", "target": "lock", "key": "Enter" },
    { "type": "expect", "observable": "fired-count", "equals": 3 },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "armed-role", "equals": "shutdown" },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "expect", "observable": "tile-width", "equals": 116 },
    { "type": "expect", "observable": "tile-height", "equals": 88 },
    { "type": "control", "group": "labels", "option": "long" },
    { "type": "expect", "observable": "tile-width", "equals": 116 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "fired-count", "equals": 3 }
  ]
}
