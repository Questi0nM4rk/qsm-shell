{
  "version": 1,
  "key": "statelayer-states",
  "target": { "story": "state-layer" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "interactive", "equals": true },
    { "type": "expect", "observable": "clickable", "equals": true },
    { "type": "pointer", "target": "host", "event": "move" },
    { "type": "await", "observable": "hovered", "equals": true },
    { "type": "expectEvent", "event": "hovered", "origin": "component" },
    { "type": "pointer", "target": "host", "event": "press" },
    { "type": "expect", "observable": "pressed", "equals": true },
    { "type": "pointer", "target": "host", "event": "release" },
    { "type": "expect", "observable": "pressed", "equals": false },
    { "type": "expect", "observable": "clicks", "equals": 1 },
    { "type": "expectEvent", "event": "clicked", "origin": "component" },
    { "type": "expect", "observable": "ring-shown", "equals": false },
    { "type": "key", "target": "host", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 2 },
    { "type": "key", "target": "host", "key": "Enter" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "action", "name": "click" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "control", "group": "purpose", "option": "trigger" },
    { "type": "expect", "observable": "clickable", "equals": false },
    { "type": "expect", "observable": "interactive", "equals": true },
    { "type": "pointer", "target": "host", "event": "press" },
    { "type": "expect", "observable": "pressed", "equals": false },
    { "type": "pointer", "target": "host", "event": "release" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "control", "group": "purpose", "option": "disabled" },
    { "type": "expect", "observable": "interactive", "equals": false },
    { "type": "expect", "observable": "hovered", "equals": false },
    { "type": "control", "group": "purpose", "option": "action" },
    { "type": "action", "name": "click" },
    { "type": "expect", "observable": "clicks", "equals": 5 }
  ]
}
