{
  "version": 1,
  "key": "switch-intent",
  "target": { "story": "switch" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "checked", "equals": true },
    { "type": "expect", "observable": "accessible-checked", "equals": true },
    { "type": "pointer", "target": "toggle", "event": "click" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "checked": false } },
    { "type": "expect", "observable": "checked", "equals": false },
    { "type": "expect", "observable": "accessible-checked", "equals": false },
    { "type": "key", "target": "toggle", "key": "Space" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "checked": true } },
    { "type": "expect", "observable": "checked", "equals": true },
    { "type": "key", "target": "toggle", "key": "Enter" },
    { "type": "expectEvent", "event": "toggle-requested", "origin": "component", "payload": { "checked": false } },
    { "type": "expect", "observable": "checked", "equals": false },
    { "type": "action", "name": "toggle" },
    { "type": "expect", "observable": "checked", "equals": true },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "action", "name": "toggle" },
    { "type": "expect", "observable": "checked", "equals": true }
  ]
}
