{
  "version": 1,
  "key": "field-failure",
  "target": { "story": "field" },
  "steps": [
    { "type": "reset" },
    { "type": "awaitIdle" },
    { "type": "control", "group": "control", "option": "switch" },
    { "type": "control", "group": "validation", "option": "ok" },
    { "type": "expect", "observable": "failed", "equals": false },
    { "type": "expect", "observable": "toggled", "equals": true },
    { "type": "expect", "observable": "toggles", "equals": 0 },
    { "type": "expect", "observable": "label", "equals": "Night light" },
    { "type": "expect", "observable": "accessibility-name", "equals": "Night light" },
    { "type": "expect", "observable": "required", "equals": true },
    { "type": "expect", "observable": "hint", "equals": "Follow the light around the room." },
    { "type": "expect", "observable": "accessibility-description", "equals": "Follow the light around the room. Required" },
    { "type": "control", "group": "required", "option": "no" },
    { "type": "expect", "observable": "accessibility-description", "equals": "Follow the light around the room." },
    { "type": "control", "group": "required", "option": "yes" },
    { "type": "control", "group": "validation", "option": "failed" },
    { "type": "expect", "observable": "failed", "equals": true },
    { "type": "expect", "observable": "error", "equals": "Pick a profile the shell can read." },
    { "type": "expect", "observable": "accessibility-description", "equals": "Pick a profile the shell can read. Required" },
    { "type": "control", "group": "hint", "option": "none" },
    { "type": "expect", "observable": "hint", "equals": "" },
    { "type": "expect", "observable": "failed", "equals": true },
    { "type": "control", "group": "required", "option": "no" },
    { "type": "expect", "observable": "required", "equals": false },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "action", "name": "toggle" },
    { "type": "expect", "observable": "toggled", "equals": false },
    { "type": "expect", "observable": "toggles", "equals": 1 },
    { "type": "expectEvent", "event": "toggle-requested" },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "toggled", "equals": true },
    { "type": "expect", "observable": "toggles", "equals": 2 },
    { "type": "control", "group": "validation", "option": "ok" },
    { "type": "expect", "observable": "failed", "equals": false },
    { "type": "expect", "observable": "accessibility-description", "equals": "" },
    { "type": "control", "group": "hint", "option": "shown" },
    { "type": "expect", "observable": "hint", "equals": "Follow the light around the room." },
    { "type": "expect", "observable": "accessibility-description", "equals": "Follow the light around the room." }
  ]
}
