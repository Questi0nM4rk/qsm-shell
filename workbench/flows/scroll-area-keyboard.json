{
  "version": 1,
  "key": "scroll-area-keyboard",
  "target": { "story": "scroll-short" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "focused", "equals": false },
    { "type": "action", "name": "focus" },
    { "type": "expect", "observable": "focused", "equals": true },
    { "type": "key", "key": "Down", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 40 },
    { "type": "key", "key": "Down", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 80 },
    { "type": "key", "key": "Up", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 40 },
    { "type": "key", "key": "PageDown", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 120 },
    { "type": "key", "key": "PageUp", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 40 },
    { "type": "key", "key": "End", "target": "viewport" },
    { "type": "expect", "observable": "at-end", "equals": true },
    { "type": "key", "key": "Down", "target": "viewport" },
    { "type": "expect", "observable": "at-end", "equals": true },
    { "type": "key", "key": "Home", "target": "viewport" },
    { "type": "expect", "observable": "at-start", "equals": true },
    { "type": "key", "key": "Up", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 0 },
    { "type": "control", "group": "axis", "option": "horizontal" },
    { "type": "control", "group": "viewport", "option": "full" },
    { "type": "action", "name": "focus" },
    { "type": "key", "key": "Right", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 40 },
    { "type": "key", "key": "Down", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 40 },
    { "type": "key", "key": "End", "target": "viewport" },
    { "type": "expect", "observable": "at-end", "equals": true },
    { "type": "key", "key": "Left", "target": "viewport" },
    { "type": "expect", "observable": "at-end", "equals": false },
    { "type": "control", "group": "content", "option": "fitting" },
    { "type": "expect", "observable": "overflows", "equals": false },
    { "type": "action", "name": "focus" },
    { "type": "key", "key": "Down", "target": "viewport" },
    { "type": "expect", "observable": "position", "equals": 0 }
  ]
}
