{
  "version": 1,
  "key": "slider-pointer-keys",
  "target": { "story": "level" },
  "steps": [
    { "type": "reset" },
    { "type": "awaitIdle" },
    { "type": "expect", "observable": "value", "equals": 87 },
    { "type": "pointer", "target": "track", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "value", "equals": 50 },
    { "type": "expectEvent", "event": "moved", "origin": "component" },
    { "type": "expectEvent", "event": "committed", "origin": "component", "payload": { "value": 50, "low-value": 0 } },
    { "type": "key", "target": "thumb", "key": "Right" },
    { "type": "expect", "observable": "value", "equals": 55 },
    { "type": "expectEvent", "event": "committed", "origin": "component", "payload": { "value": 55, "low-value": 0 } },
    { "type": "key", "target": "thumb", "key": "Left" },
    { "type": "expect", "observable": "value", "equals": 50 },
    { "type": "key", "target": "thumb", "key": "PageUp" },
    { "type": "expect", "observable": "value", "equals": 70 },
    { "type": "key", "target": "thumb", "key": "PageDown" },
    { "type": "expect", "observable": "value", "equals": 50 },
    { "type": "key", "target": "thumb", "key": "End" },
    { "type": "expect", "observable": "value", "equals": 100 },
    { "type": "expect", "observable": "can-increase", "equals": false },
    { "type": "key", "target": "thumb", "key": "Home" },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "expect", "observable": "can-decrease", "equals": false },
    { "type": "pointer", "target": "slider", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "control", "group": "wheel", "option": "nudge" },
    { "type": "pointer", "target": "slider", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expect", "observable": "value", "equals": 1 },
    { "type": "pointer", "target": "slider", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "expect", "observable": "value", "equals": 0 },
    { "type": "awaitIdle" },
    { "type": "pointer", "target": "thumb", "event": "press" },
    { "type": "pointer", "target": "track", "event": "move", "x": 0.8, "y": 0.5 },
    { "type": "pointer", "target": "track", "event": "release", "x": 0.8, "y": 0.5 },
    { "type": "expect", "observable": "value", "equals": 85 },
    { "type": "expectEvent", "event": "committed", "origin": "component" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "can-increase", "equals": false },
    { "type": "control", "group": "state", "option": "enabled" }
  ]
}
