{
  "version": 1,
  "key": "kbd-column",
  "target": { "story": "kbd" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "combo", "equals": "SUPER + SHIFT + Q" },
    { "type": "expect", "observable": "kbd-name", "equals": "SUPER + SHIFT + Q" },
    { "type": "await", "observable": "natural", "equals": true },
    { "type": "expect", "observable": "cut", "equals": false },
    { "type": "expect", "observable": "clipped", "equals": false },
    { "type": "control", "group": "column", "option": "narrow" },
    { "type": "await", "observable": "kbd-width", "equals": 112 },
    { "type": "expect", "observable": "cut", "equals": false },
    { "type": "control", "group": "column", "option": "tight" },
    { "type": "await", "observable": "kbd-width", "equals": 72 },
    { "type": "await", "observable": "cut", "equals": true },
    { "type": "expect", "observable": "clipped", "equals": true },
    { "type": "control", "group": "column", "option": "natural" },
    { "type": "control", "group": "combo", "option": "long" },
    { "type": "expect", "observable": "kbd-name", "equals": "SUPER + CTRL + ALT + SHIFT + PRINTSCREEN + ENTER" },
    { "type": "await", "observable": "natural", "equals": true },
    { "type": "expect", "observable": "cut", "equals": false },
    { "type": "control", "group": "column", "option": "narrow" },
    { "type": "await", "observable": "cut", "equals": true },
    { "type": "expect", "observable": "clipped", "equals": true },
    { "type": "control", "group": "combo", "option": "short" },
    { "type": "expect", "observable": "kbd-name", "equals": "SUPER + Q" },
    { "type": "await", "observable": "cut", "equals": false }
  ]
}
