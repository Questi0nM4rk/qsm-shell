{
  "version": 1,
  "key": "notification-center-keyboard",
  "target": { "story": "notification-center" },
  "steps": [
    { "type": "reset" },
    { "type": "action", "name": "focus-field" },
    { "type": "expect", "observable": "field-focused", "equals": true },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "key", "target": "field", "key": "Down" },
    { "type": "expect", "observable": "current-index", "equals": 1 },
    { "type": "expectEvent", "event": "selection-claimed", "origin": "component" },
    { "type": "key", "target": "field", "key": "Up" },
    { "type": "expect", "observable": "current-index", "equals": 0 },
    { "type": "key", "target": "field", "key": "Enter" },
    { "type": "expect", "observable": "expanded", "equals": true },
    { "type": "key", "target": "field", "key": "Enter" },
    { "type": "expect", "observable": "expanded", "equals": false },
    { "type": "key", "target": "field", "key": "Down" },
    { "type": "key", "target": "field", "key": "Down" },
    { "type": "expect", "observable": "current-index", "equals": 2 },
    { "type": "key", "target": "field", "key": "Enter" },
    { "type": "expect", "observable": "expanded", "equals": true },
    { "type": "action", "name": "move-action-next" },
    { "type": "action", "name": "activate" },
    { "type": "expectEvent", "event": "action-triggered", "origin": "component", "payload": { "action": "reply" } },
    { "type": "expect", "observable": "last-action", "equals": "reply" },
    { "type": "key", "target": "field", "key": "Delete" },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component" },
    { "type": "expect", "observable": "count", "equals": 2 },
    { "type": "expect", "observable": "last-dismissed", "equals": "Weekly report" },
    { "type": "key", "target": "field", "key": "Escape" },
    { "type": "expectEvent", "event": "escaped", "origin": "component" },
    { "type": "expect", "observable": "escapes", "equals": 1 },
    { "type": "write", "target": "field", "text": "power" },
    { "type": "expect", "observable": "query", "equals": "power" },
    { "type": "expect", "observable": "count", "equals": 1 },
    { "type": "write", "target": "field", "text": "zz" },
    { "type": "expect", "observable": "count", "equals": 0 }
  ]
}
