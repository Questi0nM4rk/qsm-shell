{
  "version": 1,
  "key": "empty-state-copy-action",
  "target": { "story": "empty-state" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "title", "equals": "No devices match" },
    { "type": "expect", "observable": "detail", "equals": "Widen the filter, or pair a device to see it here." },
    { "type": "expect", "observable": "icon", "equals": "search" },
    { "type": "expect", "observable": "accessible-name", "equals": "No devices match" },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "pointer", "target": "message", "event": "click", "x": 0.5, "y": 0.3 },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "pointer", "target": "recovery", "event": "click" },
    { "type": "expectEvent", "event": "clicked", "origin": "component" },
    { "type": "expect", "observable": "clicks", "equals": 1 },
    { "type": "key", "target": "recovery", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 2 },
    { "type": "key", "target": "recovery", "key": "Enter" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "control", "group": "detail", "option": "long" },
    { "type": "await", "observable": "width", "equals": 380 },
    { "type": "control", "group": "title", "option": "long" },
    { "type": "await", "observable": "width", "equals": 380 },
    { "type": "control", "group": "title", "option": "short" },
    { "type": "control", "group": "detail", "option": "title-only" },
    { "type": "expect", "observable": "detail", "equals": "" },
    { "type": "control", "group": "glyph", "option": "none" },
    { "type": "expect", "observable": "icon", "equals": "" },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "control", "group": "action", "option": "none" },
    { "type": "control", "group": "glyph", "option": "shown" },
    { "type": "expect", "observable": "icon", "equals": "search" },
    { "type": "control", "group": "detail", "option": "with-detail" },
    { "type": "expect", "observable": "detail", "equals": "Widen the filter, or pair a device to see it here." }
  ]
}
