{
  "version": 1,
  "key": "radio-group-keyboard",
  "target": { "story": "radio-group" },
  "steps": [
    { "type": "reset" },
    { "type": "await", "observable": "laid-out", "equals": true },
    { "type": "expect", "observable": "selected", "equals": 0 },
    { "type": "pointer", "target": "suspend", "event": "click" },
    { "type": "key", "target": "group", "key": "Down" },
    { "type": "expectEvent", "event": "selected", "origin": "component", "payload": { "index": 2 } },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "expect", "observable": "keyboard-focus", "equals": 2 },
    { "type": "expect", "observable": "tab-stop", "equals": 2 },
    { "type": "key", "target": "group", "key": "Down" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "key", "target": "group", "key": "Down" },
    { "type": "expect", "observable": "selected", "equals": 0 },
    { "type": "expect", "observable": "keyboard-focus", "equals": 0 },
    { "type": "key", "target": "group", "key": "Up" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "key", "target": "group", "key": "Left" },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "key", "target": "group", "key": "Right" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "key", "target": "group", "key": "Home" },
    { "type": "expect", "observable": "selected", "equals": 0 },
    { "type": "key", "target": "group", "key": "End" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "control", "group": "hibernate", "option": "available" },
    { "type": "await", "observable": "laid-out", "equals": true },
    { "type": "pointer", "target": "keep", "event": "click" },
    { "type": "key", "target": "group", "key": "Up" },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "key", "target": "group", "key": "Up" },
    { "type": "expect", "observable": "selected", "equals": 1 },
    { "type": "control", "group": "hibernate", "option": "unavailable" },
    { "type": "action", "name": "first" },
    { "type": "expect", "observable": "selected", "equals": 0 },
    { "type": "action", "name": "next" },
    { "type": "expect", "observable": "selected", "equals": 2 },
    { "type": "control", "group": "navigation", "option": "stopping" },
    { "type": "action", "name": "last" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "pointer", "target": "keep", "event": "click" },
    { "type": "key", "target": "group", "key": "Down" },
    { "type": "expect", "observable": "selected", "equals": 3 },
    { "type": "action", "name": "first" },
    { "type": "action", "name": "next" },
    { "type": "action", "name": "previous" },
    { "type": "expect", "observable": "selected", "equals": 0 }
  ]
}
