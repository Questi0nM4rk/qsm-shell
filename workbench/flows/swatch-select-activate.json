{
  "version": 1,
  "key": "swatch-select-activate",
  "target": { "story": "swatch" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selected", "equals": false },
    { "type": "expect", "observable": "empty", "equals": false },
    { "type": "expect", "observable": "reading", "equals": "Sand" },
    { "type": "expect", "observable": "enabled", "equals": true },
    { "type": "expect", "observable": "contained", "equals": false },
    { "type": "control", "group": "sample", "option": "plum" },
    { "type": "expect", "observable": "contained", "equals": true },
    { "type": "control", "group": "ground", "option": "surface" },
    { "type": "expect", "observable": "contained", "equals": true },
    { "type": "control", "group": "ground", "option": "overlay" },
    { "type": "expect", "observable": "contained", "equals": true },
    { "type": "control", "group": "ground", "option": "band" },
    { "type": "control", "group": "sample", "option": "translucent" },
    { "type": "expect", "observable": "contained", "equals": false },
    { "type": "control", "group": "sample", "option": "empty" },
    { "type": "expect", "observable": "empty", "equals": true },
    { "type": "expect", "observable": "reading", "equals": "" },
    { "type": "expect", "observable": "contained", "equals": false },
    { "type": "control", "group": "sample", "option": "iris" },
    { "type": "expect", "observable": "reading", "equals": "Iris" },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "pointer", "target": "swatch", "event": "click" },
    { "type": "expectEvent", "event": "clicked", "origin": "component", "payload": { "empty": false, "selected": false } },
    { "type": "expect", "observable": "clicks", "equals": 1 },
    { "type": "expect", "observable": "keyboard-focus", "equals": false },
    { "type": "key", "target": "swatch", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 2 },
    { "type": "expect", "observable": "keyboard-focus", "equals": true },
    { "type": "key", "target": "swatch", "key": "Enter" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "pointer", "target": "swatch", "event": "press" },
    { "type": "pointer", "target": "scene", "event": "move", "x": 0.02, "y": 0.02 },
    { "type": "pointer", "target": "scene", "event": "release", "x": 0.02, "y": 0.02 },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "control", "group": "selection", "option": "selected" },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "expect", "observable": "enabled", "equals": true }
  ]
}
