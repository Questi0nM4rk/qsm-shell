{
  "version": 1,
  "key": "swatch-select-activate",
  "target": { "story": "swatch" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "selected", "equals": false },
    { "type": "expect", "observable": "empty", "equals": false },
    { "type": "expect", "observable": "reading", "equals": "#E8C58A" },
    { "type": "expect", "observable": "enabled", "equals": true },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "control", "group": "selection", "option": "selected" },
    { "type": "expect", "observable": "selected", "equals": true },
    { "type": "control", "group": "sample", "option": "empty" },
    { "type": "expect", "observable": "empty", "equals": true },
    { "type": "expect", "observable": "reading", "equals": "" },
    { "type": "control", "group": "sample", "option": "deep" },
    { "type": "expect", "observable": "empty", "equals": false },
    { "type": "expect", "observable": "reading", "equals": "#C5A5E9" },
    { "type": "action", "name": "activate" },
    { "type": "expectEvent", "event": "clicked", "origin": "component" },
    { "type": "expect", "observable": "clicks", "equals": 1 },
    { "type": "key", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 2 },
    { "type": "key", "key": "Enter" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "key", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "control", "group": "state", "option": "enabled" },
    { "type": "expect", "observable": "enabled", "equals": true }
  ]
}
