{
  "version": 1,
  "key": "icon-button-activate",
  "target": { "story": "icon-button" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "enabled", "equals": true },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "pointer", "target": "button", "event": "move" },
    { "type": "pointer", "target": "button", "event": "press" },
    { "type": "expect", "observable": "clicks", "equals": 0 },
    { "type": "pointer", "target": "button", "event": "release" },
    { "type": "expect", "observable": "clicks", "equals": 1 },
    { "type": "expectEvent", "event": "clicked", "origin": "component" },
    { "type": "key", "target": "button", "key": "Space" },
    { "type": "expect", "observable": "clicks", "equals": 2 },
    { "type": "key", "target": "button", "key": "Enter" },
    { "type": "expect", "observable": "clicks", "equals": 3 },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "clicks", "equals": 4 },
    { "type": "expect", "observable": "accessible-button", "equals": true },
    { "type": "expect", "observable": "accessible-name", "equals": "Apply" },
    { "type": "control", "group": "glyph", "option": "play" },
    { "type": "expect", "observable": "accessible-name", "equals": "Play" },
    { "type": "expect", "observable": "glyph", "equals": "play" },
    { "type": "control", "group": "size", "option": "lg" },
    { "type": "expect", "observable": "size", "equals": "lg" },
    { "type": "control", "group": "state", "option": "disabled" },
    { "type": "expect", "observable": "enabled", "equals": false },
    { "type": "action", "name": "activate" },
    { "type": "expect", "observable": "clicks", "equals": 4 }
  ]
}
