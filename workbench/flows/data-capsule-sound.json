{
  "version": 1,
  "key": "data-capsule-sound",
  "target": { "composition": "compositions/capsule-sound.json" },
  "steps": [
    { "type": "reset" },
    { "type": "control", "node": "capsule", "group": "lifetime", "option": "persistent" },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "expect", "node": "capsule", "observable": "edge", "equals": "right" },
    { "type": "expect", "node": "sound", "observable": "orientation", "equals": "vertical" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "pointer", "node": "sound", "target": "mute-label", "event": "click" },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "component", "payload": { "muted": true } },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": true },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "pointer", "node": "sound", "target": "mute-label", "event": "click" },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "component", "payload": { "muted": false } },
    { "type": "expectEvent", "node": "sound", "event": "mute-changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "pointer", "node": "sound", "target": "slider", "event": "wheel", "dx": 0, "dy": 120 },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "component", "payload": { "level": 47 } },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 47 },
    { "type": "expect", "node": "capsule", "observable": "open", "equals": true },
    { "type": "pointer", "node": "sound", "target": "slider", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "component", "payload": { "level": 42 } },
    { "type": "expectEvent", "node": "sound", "event": "changed", "origin": "route", "targetNode": "capsule" },
    { "type": "expect", "node": "sound", "observable": "level", "equals": 42 },
    { "type": "expect", "node": "sound", "observable": "muted", "equals": false }
  ]
}
