{
  "version": 1,
  "key": "popover-keyboard",
  "target": { "story": "popover" },
  "steps": [
    { "type": "reset" },
    { "type": "control", "group": "state", "option": "closed" },
    { "type": "control", "group": "trigger", "option": "press" },
    { "type": "expect", "observable": "open", "equals": false },
    { "type": "pointer", "target": "anchor", "event": "click" },
    { "type": "expectEvent", "event": "open-requested", "origin": "component" },
    { "type": "expect", "observable": "open", "equals": true },
    { "type": "expect", "observable": "focus", "equals": "anchor" },
    { "type": "pointer", "target": "anchor", "event": "click" },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component" },
    { "type": "expect", "observable": "open", "equals": false },
    { "type": "key", "target": "scene", "key": "Enter" },
    { "type": "expect", "observable": "open", "equals": true },
    { "type": "expect", "observable": "open-requests", "equals": 2 },
    { "type": "key", "target": "scene", "key": "Tab" },
    { "type": "expect", "observable": "focus", "equals": "settings" },
    { "type": "key", "target": "scene", "key": "Space" },
    { "type": "expectEvent", "event": "settings-clicked", "origin": "component" },
    { "type": "expect", "observable": "settings-clicks", "equals": 1 },
    { "type": "key", "target": "scene", "key": "Escape" },
    { "type": "expectEvent", "event": "dismiss-requested", "origin": "component" },
    { "type": "await", "observable": "open", "equals": false },
    { "type": "await", "observable": "focus", "equals": "anchor" },
    { "type": "key", "target": "scene", "key": "Space" },
    { "type": "expect", "observable": "open", "equals": true },
    { "type": "expect", "observable": "open-requests", "equals": 3 },
    { "type": "pointer", "target": "settings", "event": "click" },
    { "type": "expect", "observable": "settings-clicks", "equals": 2 },
    { "type": "expect", "observable": "open", "equals": true }
  ]
}
