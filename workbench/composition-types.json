{
  "version": 1,
  "tokens": ["none", "xs", "sm", "md", "lg"],
  "types": {
    "column": {
      "label": "Column",
      "category": "layout",
      "children": "many",
      "props": {
        "spacing": { "type": "spacing", "default": "sm" },
        "padding": { "type": "spacing", "default": "none" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": [],
      "actions": []
    },
    "row": {
      "label": "Row",
      "category": "layout",
      "children": "many",
      "props": {
        "spacing": { "type": "spacing", "default": "sm" },
        "padding": { "type": "spacing", "default": "none" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": [],
      "actions": []
    },
    "stack": {
      "label": "Stack",
      "category": "layout",
      "children": "many",
      "props": {
        "spacing": { "type": "spacing", "default": "sm" },
        "padding": { "type": "spacing", "default": "none" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": [],
      "actions": []
    },
    "text-field": {
      "label": "Text field",
      "category": "leaf",
      "children": "none",
      "props": {
        "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md" },
        "state": { "type": "enum", "values": ["default", "filled", "error", "disabled"], "default": "default" },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "text": { "type": "string", "maxLength": 200, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["accepted", "changed"],
      "actions": ["clear", "focus"]
    },
    "checkbox": {
      "label": "Checkbox",
      "category": "leaf",
      "children": "none",
      "props": {
        "checked": { "type": "boolean", "default": false },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["toggled"],
      "actions": ["toggle", "check", "uncheck"]
    },
    "switch": {
      "label": "Switch",
      "category": "leaf",
      "children": "none",
      "props": {
        "checked": { "type": "boolean", "default": false },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["toggled"],
      "actions": ["toggle"]
    },
    "radio": {
      "label": "Radio",
      "category": "leaf",
      "children": "none",
      "props": {
        "checked": { "type": "boolean", "default": false },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["selected"],
      "actions": ["select"]
    },
    "slider": {
      "label": "Slider",
      "category": "leaf",
      "children": "none",
      "props": {
        "value": { "type": "number", "min": 0, "max": 100, "default": 50 },
        "orientation": { "type": "enum", "values": ["horizontal", "vertical"], "default": "horizontal" },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["changed"],
      "actions": ["reset"]
    },
    "sound-channel": {
      "label": "Sound channel",
      "category": "leaf",
      "children": "none",
      "props": {
        "level": { "type": "number", "min": 0, "max": 100, "default": 50 },
        "muted": { "type": "boolean", "default": false },
        "icon": { "type": "string", "maxLength": 80, "default": "volume" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["changed", "mute-changed"],
      "actions": ["increase", "decrease", "minimum", "maximum", "toggle-mute"]
    },
    "segmented": {
      "label": "Segmented",
      "category": "leaf",
      "children": "none",
      "props": {
        "selected": { "type": "number", "integer": true, "min": 0, "max": 7, "default": 0 },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["changed"],
      "actions": ["reset"]
    },
    "spin-box": {
      "label": "Spin box",
      "category": "leaf",
      "children": "none",
      "props": {
        "value": { "type": "number", "min": -1000, "max": 1000, "default": 0 },
        "label": { "type": "string", "maxLength": 80, "default": "" },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["changed"],
      "actions": ["increment", "decrement", "reset"]
    },
    "menu-items": {
      "label": "Shell menu composition",
      "category": "fixture",
      "children": "none",
      "props": {
        "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md" },
        "width": { "type": "number", "min": 240, "max": 1920 },
        "height": { "type": "number", "min": 240, "max": 1200 }
      },
      "events": ["activated", "moved", "committed", "mute-toggled", "wifi-radio-toggled", "bluetooth-radio-toggled", "wifi-connect", "wifi-result", "ble-connect", "ble-result", "device-toggled", "device-forgotten", "scan-result"],
      "actions": ["step-next", "step-previous", "activate", "close-editor", "increase", "decrease", "toggle-mute", "connect-wifi", "connect-ble"]
    },
    "menu": {
      "label": "Menu",
      "category": "container",
      "children": "many",
      "props": {
        "title": { "type": "string", "maxLength": 80, "default": "" },
        "open": { "type": "boolean", "default": false },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["opened", "closed", "selected"],
      "actions": ["open", "close", "toggle"]
    },
    "shell-border-rollout": {
      "label": "Shell border rollout",
      "category": "container",
      "children": "many",
      "props": {
        "side": { "type": "enum", "values": ["left", "right", "top", "bottom"], "default": "right" },
        "open": { "type": "boolean", "default": false },
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": ["opened", "closed"],
      "actions": ["open", "close", "toggle"]
    },
    "mock-screen": {
      "label": "Mock screen",
      "category": "container",
      "children": "many",
      "props": {
        "width": { "type": "number", "min": 40, "max": 1920 },
        "height": { "type": "number", "min": 24, "max": 1200 }
      },
      "events": [],
      "actions": []
    },
    "data-capsule": {
      "label": "Data capsule",
      "category": "container",
      "children": "many",
      "props": {
        "open": { "type": "boolean", "default": true },
        "hover-stay": { "type": "boolean", "default": true },
        "interactive": { "type": "boolean", "default": false },
        "elevated": { "type": "boolean", "default": true },
        "timeout": { "type": "number", "min": 0, "max": 3600000, "default": 0 },
        "edge": { "type": "enum", "values": ["left", "right", "top", "bottom"], "default": "bottom" },
        "alignment": { "type": "enum", "values": ["start", "center", "end"], "default": "center" },
        "inset": { "type": "spacing", "default": "md" },
        "orientation": { "type": "enum", "values": ["horizontal", "vertical"], "default": "horizontal" },
        "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md" },
        "length": { "type": "enum", "values": ["short", "default", "long", "content"], "default": "default" }
      },
      "events": ["activated", "timeout-requested"],
      "actions": ["open", "close", "restart", "cancel-timeout", "activate"]
    }
  }
}
